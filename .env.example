# ==============================================================================
# UNIFIED AUTONOMOUS JOB ENGINE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE & NAUKRI AUTHENTICATION
# ------------------------------------------------------------------------------
GOOGLE_EMAIL=your_email@gmail.com
GOOGLE_PASSWORD=your_password_here
NAUKRI_PROFILE_URL=https://www.naukri.com/mnjuser/profile

# ------------------------------------------------------------------------------
# 2. GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Get your free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
MIN_JOB_MATCH_SCORE=70

# ------------------------------------------------------------------------------
# 3. EMAIL & COMMUNICATION CHANNEL (Nodemailer SMTP)
# ------------------------------------------------------------------------------
# Set to 'true' to send email notifications for daily reports, errors, and captcha alerts
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_password_here
NOTIFICATION_RECIPIENT=your_notification_recipient@gmail.com

# ------------------------------------------------------------------------------
# 4. CANDIDATE PROFILE & CV DATA (Used for Cover Letters & Form Filling)
# ------------------------------------------------------------------------------
CANDIDATE_NAME="Your Name"
CANDIDATE_EMAIL=your_email@gmail.com
CANDIDATE_PHONE="+91 9876543210"
CANDIDATE_LOCATION="Your City, Country"
CANDIDATE_CURRENT_ROLE="Software Engineer"
CANDIDATE_COMPANY="Example Tech"
CANDIDATE_EDUCATION="B.Tech in Computer Science"
CANDIDATE_EXPERIENCE="3+ years"
CANDIDATE_SKILLS="JavaScript, TypeScript, React, Next.js, Node.js, Express, Python, FastAPI, MongoDB, PostgreSQL, Gemini AI, Docker, AWS"
CANDIDATE_HIGHLIGHT_1="Built and scaled full-stack web applications handling high traffic volume"
CANDIDATE_HIGHLIGHT_2="Designed microservices and REST/GraphQL APIs with high availability"
CANDIDATE_HIGHLIGHT_3="Integrated AI models and workflows for automated optimization"
CANDIDATE_HIGHLIGHT_4="Implemented CI/CD pipelines and Docker containers on cloud infrastructure"
CANDIDATE_HIGHLIGHT_5="Collaborated in agile teams delivering features from concept to production deployment"

CANDIDATE_NOTICE_PERIOD="Immediate / 15 days"
CANDIDATE_CURRENT_CTC="10 LPA"
CANDIDATE_EXPECTED_CTC="15 LPA"
CANDIDATE_CURRENT_SALARY="10,00,000 INR"
CANDIDATE_EXPECTED_SALARY="18,00,000 INR"
CANDIDATE_DOB="01/01/2000"
CANDIDATE_GENDER="Male"
CANDIDATE_WORK_AUTH="Authorized to work, open to remote / visa sponsorship"

CANDIDATE_GITHUB="https://github.com/yourusername"
CANDIDATE_LINKEDIN="https://linkedin.com/in/yourusername"
CANDIDATE_PORTFOLIO="https://yourportfolio.dev"
CANDIDATE_LINKS="GitHub: https://github.com/yourusername | Portfolio: https://yourportfolio.dev"

CANDIDATE_REMOTE_OK="Yes, I am fully setup for remote work."
CANDIDATE_RELOCATE="Yes, willing to relocate."
CANDIDATE_START_DATE="Immediate / within 15 days"

# ------------------------------------------------------------------------------
# 5. APPLICATION LIMITS & PACING
# ------------------------------------------------------------------------------
WELLFOUND_DAILY_CAP=50
NAUKRI_DAILY_CAP=20
MIN_DELAY_MS=60000
MAX_DELAY_MS=150000
